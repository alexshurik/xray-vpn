        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Download (24h)"
          }
        ]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "expr": "topk(10, sum by (email) (increase(x_ui_client_down_bytes[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top 10 Users by Download (24 hours)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value": "Download (24h)",
