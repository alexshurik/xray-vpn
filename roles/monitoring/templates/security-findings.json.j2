            "textMode": "auto"
          }
        },
        {
          "id": 203,
          "type": "stat",
          "title": "Medium (sev=2)",
          "datasource": { "type": "loki", "uid": "loki" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"security-events\",container=\"tracee\"} | json | eventName=~\"$tracee_attention_events\" | json severity=\"metadata.Properties.Severity\" | severity = \"2\" [$security_window_long])) or vector(0)"
            }
          ],
          "gridPos": { "h": 4, "w": 6, "x": 12, "y": 29 },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
