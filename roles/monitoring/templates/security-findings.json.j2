{
  "id": null,
  "uid": "security-findings",
  "title": "Security Findings",
  "tags": ["security", "falco", "tracee", "trivy", "loki", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 111,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tracee_attention_events",
        "label": "Tracee event filter (regex)",
        "type": "textbox",
        "query": "{{ security_tracee_event_regex }}",
        "current": {
          "text": "{{ security_tracee_event_regex }}",
          "value": "{{ security_tracee_event_regex }}"
        }
      },
      {
        "name": "falco_attention_priority",
        "label": "Falco priority filter",
        "type": "textbox",
        "query": "{{ security_falco_priority_regex }}",
        "current": {
          "text": "{{ security_falco_priority_regex }}",
          "value": "{{ security_falco_priority_regex }}"
        }
      },
      {
        "name": "falco_ignore_rules",
        "label": "Falco ignore rule regex",
        "type": "textbox",
        "query": "{{ security_falco_ignore_rule_regex }}",
        "current": {
          "text": "{{ security_falco_ignore_rule_regex }}",
          "value": "{{ security_falco_ignore_rule_regex }}"
        }
      },
      {
        "name": "security_window_short",
        "label": "Short window",
        "type": "textbox",
        "query": "15m",
        "current": {
          "text": "15m",
          "value": "15m"
        }
      },
      {
        "name": "security_window_long",
        "label": "Long window",
        "type": "textbox",
        "query": "$__range",
        "current": {
          "text": "$__range",
          "value": "$__range"
        }
      },
      {
        "name": "trivy_severity_focus",
        "label": "Trivy severity filter",
        "type": "textbox",
        "query": "CRITICAL|HIGH",
        "current": {
          "text": "CRITICAL|HIGH",
          "value": "CRITICAL|HIGH"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Trivy Critical",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "trivy_vulnerabilities_total{severity=\"CRITICAL\"} or vector(0)"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Trivy High",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "trivy_vulnerabilities_total{severity=\"HIGH\"} or vector(0)"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last Trivy Scan",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "trivy_last_scan_timestamp_seconds * 1000"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Falco Critical+Error",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"security-events\",container=\"falco\"} | json | priority=~\"Error|Critical|Alert|Emergency\" | rule!~\"$falco_ignore_rules\" [$security_window_long])) or vector(0)"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tracee High+Critical",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"security-events\",container=\"tracee\"} | json | eventName=~\"$tracee_attention_events\" | json severity=\"metadata.Properties.Severity\" | severity >= 3 [$security_window_long])) or vector(0)"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Events",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({job=\"security-events\",container=\"falco\"} | json | priority=~\"$falco_attention_priority\" | rule!~\"$falco_ignore_rules\" [$security_window_long])) or vector(0)) + (sum(count_over_time({job=\"security-events\",container=\"tracee\"} | json | eventName=~\"$tracee_attention_events\" | processName!~\"{{ security_tracee_ignore_process_regex | replace('\\\\', '\\\\\\\\') }}\" [$security_window_long])) or vector(0))"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },

    {
      "id": 100,
      "type": "row",
      "title": "Trivy Vulnerability Scanner",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 101,
      "type": "bargauge",
      "title": "Vulnerabilities by Severity",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "trivy_vulnerabilities_total",
          "legendFormat": "{{ '{{' }}severity{{ '}}' }}"
        }
      ],
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CRITICAL" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "HIGH" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "MEDIUM" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "LOW" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "UNKNOWN" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      }
    },
    {
      "id": 102,
      "type": "table",
      "title": "Vulnerabilities by Target",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target) (trivy_vulnerabilities_total)",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": { "target": "Target", "Value": "Total Vulns" }
          }
        }
      ]
    },
    {
      "id": 103,
      "type": "table",
      "title": "Top CVEs (by frequency)",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(40, sum by (cve, severity) (count_over_time({job=\"security-events\",container=\"trivy-runner\"} | json | event=\"TRIVY_VULN\" | severity=~\"$trivy_severity_focus\" [$security_window_long])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [{ "displayName": "Value", "desc": true }] }
    },
    {
      "id": 104,
      "type": "table",
      "title": "Trivy Vulnerability Details",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"security-events\",container=\"trivy-runner\"} | json | event=\"TRIVY_VULN\" | severity=~\"$trivy_severity_focus\" | line_format \"{{ '{{' }}.severity{{ '}}' }}||{{ '{{' }}.cve{{ '}}' }}||{{ '{{' }}.target{{ '}}' }}||{{ '{{' }}.package{{ '}}' }}||{{ '{{' }}.installed{{ '}}' }}||{{ '{{' }}.fixed{{ '}}' }}||{{ '{{' }}.title{{ '}}' }}||{{ '{{' }}.description{{ '}}' }}\"",
          "queryType": "range"
        }
      ],
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "CRITICAL": { "color": "red", "text": "CRITICAL" } } },
                  { "type": "value", "options": { "HIGH": { "color": "orange", "text": "HIGH" } } },
                  { "type": "value", "options": { "MEDIUM": { "color": "yellow", "text": "MEDIUM" } } },
                  { "type": "value", "options": { "LOW": { "color": "blue", "text": "LOW" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CVE" },
            "properties": [
              { "id": "custom.width", "value": 150 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View on NVD",
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.text}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Description" },
            "properties": [
              { "id": "custom.width", "value": 400 },
              { "id": "custom.inspect", "value": true }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Severity", "desc": true }]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "id": true, "tsNs": true, "labels": true, "Line": true },
            "renameByName": {
              "severity": "Severity",
              "cve": "CVE",
              "target": "Target",
              "package": "Package",
              "installed": "Installed",
              "fixed": "Fix Version",
              "title": "Title",
              "description": "Description"
            },
            "indexByName": {
              "severity": 0,
              "cve": 1,
              "target": 2,
              "package": 3,
              "installed": 4,
              "fixed": 5,
              "title": 6,
              "description": 7
            }
          }
        }
      ]
    },

    {
      "id": 200,
      "type": "row",
      "title": "Tracee Runtime Detection",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": [
        {
          "id": 201,
          "type": "stat",
          "title": "Critical (sev=4)",
          "datasource": { "type": "loki", "uid": "loki" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"security-events\",container=\"tracee\"} | json | eventName=~\"$tracee_attention_events\" | json severity=\"metadata.Properties.Severity\" | severity = \"4\" [$security_window_long])) or vector(0)"
            }
          ],
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 29 },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "red", "value": 1 }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "textMode": "auto"
          }
        },
        {
          "id": 202,
          "type": "stat",
          "title": "High (sev=3)",
          "datasource": { "type": "loki", "uid": "loki" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"security-events\",container=\"tracee\"} | json | eventName=~\"$tracee_attention_events\" | json severity=\"metadata.Properties.Severity\" | severity = \"3\" [$security_window_long])) or vector(0)"
            }
          ],
          "gridPos": { "h": 4, "w": 6, "x": 6, "y": 29 },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "orange", "value": 1 }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "colorMode": "value",
            "graphMode": "none",
