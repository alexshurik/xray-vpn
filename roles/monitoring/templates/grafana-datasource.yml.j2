apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    # All services use host network
    url: http://localhost:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: "30s"

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://localhost:{{ loki_port }}
    isDefault: false
    editable: false
