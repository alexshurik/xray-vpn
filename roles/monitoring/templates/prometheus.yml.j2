---
# Prometheus configuration for VPN monitoring
# Scrapes metrics from 3x-ui-exporter

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    monitor: 'vpn-monitor'
    instance: '{{ ansible_host }}'

scrape_configs:
  # Prometheus self-monitoring
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
    scrape_interval: 30s

  # 3x-ui-exporter metrics
  # Access via localhost since 3x-ui-exporter exposes port on host
  - job_name: '3x-ui-exporter'
    static_configs:
      - targets: ['localhost:{{ exporter_port }}']
        labels:
          service: '3x-ui'
          host: '{{ ansible_host }}'
    scrape_interval: 30s
    metrics_path: /metrics

  # Node Exporter - system metrics
  # Both Prometheus and node-exporter use host network
  - job_name: 'node-exporter'
    static_configs:
      - targets: ['localhost:9100']
        labels:
          host: '{{ ansible_host }}'
          instance: '{{ ansible_host }}:9100'
    scrape_interval: 15s
    metrics_path: /metrics

  # Loki metrics
  - job_name: 'loki'
    static_configs:
      - targets: ['localhost:{{ loki_port }}']
        labels:
          host: '{{ ansible_host }}'
    scrape_interval: 30s
    metrics_path: /metrics

  # Promtail metrics
  - job_name: 'promtail'
    static_configs:
      - targets: ['localhost:{{ promtail_port }}']
        labels:
          host: '{{ ansible_host }}'
    scrape_interval: 30s
    metrics_path: /metrics
