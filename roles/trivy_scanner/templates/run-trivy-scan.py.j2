#!/usr/bin/env python3
"""Run Trivy scans, emit Prometheus metrics, and write actionable Loki events."""

from __future__ import annotations

import fcntl
import gzip
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, Iterable, List, Sequence, Tuple

REPORTS_DIR = Path({{ trivy_reports_dir | to_json }})
CACHE_DIR = Path({{ trivy_cache_dir | to_json }})
METRICS_DIR = Path({{ trivy_metrics_dir | to_json }})
METRICS_FILE = METRICS_DIR / "trivy.prom"
LOG_FILE = Path({{ trivy_log_file | to_json }})
TRIVY_IMAGE = {{ trivy_image | to_json }}
TRIVY_SEVERITY = {{ trivy_severity | to_json }}
RETENTION_DAYS = {{ trivy_retention_days | int }}
COMPRESS_AFTER_DAYS = {{ trivy_compress_after_days | int }}
REPORTS_MAX_SIZE_MB = {{ trivy_reports_max_size_mb | int }}
TRIVY_EMIT_DETAILED_FINDINGS = {{ trivy_emit_detailed_findings | bool | ternary('True', 'False') }}
LOCK_FILE = Path("/tmp/trivy-scan.lock")
SEVERITIES: Sequence[str] = ("UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL")
DOCKER_PS_FORMAT = "{% raw %}{{.Image}}{% endraw %}"


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def format_utc(value: datetime, fmt: str) -> str:
    return value.strftime(fmt)


def append_log(raw_line: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(raw_line)


def log_msg(message: str) -> None:
    timestamp = format_utc(utc_now(), "%Y-%m-%dT%H:%M:%SZ")
    append_log(f"[{timestamp}] {message}\n")


def log_json_line(payload: Dict[str, str]) -> None:
    append_log(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")


def ensure_directories() -> None:
    for path in (REPORTS_DIR, CACHE_DIR, METRICS_DIR, LOG_FILE.parent):
        path.mkdir(parents=True, exist_ok=True)


def run_command(command: Sequence[str], allow_failure: bool = False) -> subprocess.CompletedProcess[str]:
    process = subprocess.run(command, capture_output=True, text=True, check=False)
    if process.stdout:
        append_log(process.stdout if process.stdout.endswith("\n") else process.stdout + "\n")
    if process.stderr:
        append_log(process.stderr if process.stderr.endswith("\n") else process.stderr + "\n")

    if process.returncode != 0 and not allow_failure:
        rendered_command = " ".join(command)
        raise RuntimeError(f"command failed ({process.returncode}): {rendered_command}")

    return process


def compact_text(raw_value: object, max_len: int, default: str = "") -> str:
    text = str(raw_value or default)
    text = re.sub(r"[\r\n\t]+", " ", text)
    return text[:max_len]


def safe_image_name(image: str) -> str:
    translated = image.translate(str.maketrans({"/": "_", ":": "_", "@": "_"}))
    return re.sub(r"[^A-Za-z0-9_.-]", "", translated)


def report_target(report_name: str, date_utc: str) -> str:
    suffix = f"-{date_utc}.json"
    if report_name.startswith("rootfs-"):
        target = "/host"
    elif report_name.startswith("image-"):
        target = report_name[len("image-") : -len(suffix)]
    else:
        target = report_name[: -len(suffix)]
    return target.replace('"', "'")


def load_report(report_path: Path) -> Dict[str, object]:
    with report_path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def extract_vulns(report_data: Dict[str, object]) -> Iterable[Tuple[str, Dict[str, object], Dict[str, object]]]:
    results = report_data.get("Results") or []
    if not isinstance(results, list):
        return []

    rows: List[Tuple[str, Dict[str, object], Dict[str, object]]] = []
    for result in results:
        if not isinstance(result, dict):
            continue
        vulnerabilities = result.get("Vulnerabilities") or []
        if not isinstance(vulnerabilities, list):
            continue
        for vuln in vulnerabilities:
            if not isinstance(vuln, dict):
                continue
            severity = str(vuln.get("Severity") or "UNKNOWN").upper()
            if severity not in SEVERITIES:
                severity = "UNKNOWN"
            rows.append((severity, result, vuln))
    return rows


def write_metrics(metrics_lines: Sequence[str]) -> None:
    tmp_path = METRICS_FILE.with_name(METRICS_FILE.name + ".tmp")
    with tmp_path.open("w", encoding="utf-8") as handle:
        handle.write("\n".join(metrics_lines) + "\n")
    os.replace(tmp_path, METRICS_FILE)

    metrics_mtime = datetime.fromtimestamp(METRICS_FILE.stat().st_mtime, tz=timezone.utc)
    append_log(f"{metrics_mtime.isoformat()} {METRICS_FILE}\n")


def older_than_days(path: Path, days: int) -> bool:
    if days <= 0:
        return True
    age_seconds = time.time() - path.stat().st_mtime
    return age_seconds > (days * 24 * 60 * 60)


def compress_reports() -> None:
    for report_path in sorted(REPORTS_DIR.glob("*.json")):
        if not older_than_days(report_path, COMPRESS_AFTER_DAYS):
            continue
        gzip_path = report_path.with_suffix(report_path.suffix + ".gz")
        with report_path.open("rb") as source_handle, gzip.open(gzip_path, "wb") as gzip_handle:
            shutil.copyfileobj(source_handle, gzip_handle)
        report_path.unlink(missing_ok=True)


def delete_old_reports() -> None:
    for pattern in ("*.json", "*.json.gz"):
        for report_path in REPORTS_DIR.glob(pattern):
            if older_than_days(report_path, RETENTION_DAYS):
                report_path.unlink(missing_ok=True)


def reports_dir_size_mb() -> int:
    total_bytes = 0
    for path in REPORTS_DIR.iterdir():
        if path.is_file():
            total_bytes += path.stat().st_size
    if total_bytes == 0:
        return 0
    return int(math.ceil(total_bytes / (1024 * 1024)))


def enforce_size_cap() -> None:
    if REPORTS_MAX_SIZE_MB <= 0:
        return

    current_size_mb = reports_dir_size_mb()
    if current_size_mb <= REPORTS_MAX_SIZE_MB:
        return

    log_msg(
        "Trivy reports dir exceeds cap "
        f"({current_size_mb}MB > {REPORTS_MAX_SIZE_MB}MB), pruning oldest reports"
    )

    while current_size_mb > REPORTS_MAX_SIZE_MB:
        candidates = sorted(
            [
                path
                for pattern in ("*.json", "*.json.gz")
                for path in REPORTS_DIR.glob(pattern)
                if path.is_file()
            ],
            key=lambda path: path.stat().st_mtime,
        )
        if not candidates:
            break

        candidates[0].unlink(missing_ok=True)
        current_size_mb = reports_dir_size_mb()

    log_msg(f"Trivy reports dir size after cap enforcement: {current_size_mb}MB")


def emit_detail_table(report_name: str, target: str) -> None:
    log_msg(f"TRIVY_FINDINGS_START target={target} severity=HIGH,CRITICAL report={report_name}")
    convert_cmd = [
        "docker",
        "run",
        "--rm",
        "-v",
        f"{REPORTS_DIR}:/reports:ro",
        TRIVY_IMAGE,
        "convert",
        "--format",
        "table",
        "--severity",
        "HIGH,CRITICAL",
        f"/reports/{report_name}",
    ]
    process = run_command(convert_cmd, allow_failure=True)
    if process.stdout:
        for line in process.stdout.splitlines():
            append_log(f"TRIVY_FINDING_DETAIL target={target} {line}\n")
    log_msg(f"TRIVY_FINDINGS_END target={target}")


def run_scan() -> int:
    date_utc = format_utc(utc_now(), "%Y%m%dT%H%M%SZ")
    rootfs_report = REPORTS_DIR / f"rootfs-{date_utc}.json"

    rootfs_cmd = [
        "docker",
        "run",
        "--rm",
        "-v",
        "/:/host:ro",
        "-v",
        f"{REPORTS_DIR}:/reports",
        "-v",
        f"{CACHE_DIR}:/root/.cache/",
        TRIVY_IMAGE,
        "rootfs",
        "--scanners",
        "vuln",
        "--severity",
        TRIVY_SEVERITY,
        "--skip-dirs",
        "/host/proc",
        "--skip-dirs",
        "/host/sys",
        "--skip-dirs",
        "/host/dev",
        "--skip-dirs",
        "/host/run",
        "--skip-dirs",
        "/host/var/lib/docker",
        "--format",
        "json",
        "--output",
        f"/reports/{rootfs_report.name}",
        "/host",
    ]
    run_command(rootfs_cmd)

    images_cmd = ["docker", "ps", "--format", DOCKER_PS_FORMAT]
    images_result = run_command(images_cmd)
    images = sorted({line.strip() for line in images_result.stdout.splitlines() if line.strip()})

    for image in images:
        safe_name = safe_image_name(image)
        image_report = REPORTS_DIR / f"image-{safe_name}-{date_utc}.json"

        image_cmd = [
            "docker",
            "run",
            "--rm",
            "-v",
            "/var/run/docker.sock:/var/run/docker.sock",
            "-v",
            f"{REPORTS_DIR}:/reports",
            "-v",
            f"{CACHE_DIR}:/root/.cache/",
            TRIVY_IMAGE,
            "image",
            "--scanners",
            "vuln",
            "--severity",
            TRIVY_SEVERITY,
            "--format",
            "json",
            "--output",
            f"/reports/{image_report.name}",
            image,
        ]
        run_command(image_cmd, allow_failure=True)

    reports = sorted(REPORTS_DIR.glob(f"*-{date_utc}.json"))
    if not reports:
        append_log(f"No Trivy reports generated for {date_utc}\n")
        return 1

    totals = {severity: 0 for severity in SEVERITIES}
    metrics_lines: List[str] = [
        "# HELP trivy_vulnerabilities Vulnerabilities found by Trivy scan",
        "# TYPE trivy_vulnerabilities gauge",
    ]

    for report_path in reports:
        report_name = report_path.name
        target = report_target(report_name, date_utc)
        data = load_report(report_path)
        rows = list(extract_vulns(data))

        per_report = {severity: 0 for severity in SEVERITIES}
        for severity, _, _ in rows:
            per_report[severity] += 1
            totals[severity] += 1

        for severity in SEVERITIES:
            metrics_lines.append(
                'trivy_vulnerabilities{target="%s",severity="%s"} %s'
                % (target, severity, per_report[severity])
            )

        report_high = per_report["HIGH"]
        report_critical = per_report["CRITICAL"]
        if report_high > 0 or report_critical > 0:
            log_msg(
                f"TRIVY_FINDING target={target} high={report_high} "
                f"critical={report_critical} report={report_name}"
            )

            for severity, scan_result, vuln in rows:
                if severity not in ("HIGH", "CRITICAL"):
                    continue

                cve = str(vuln.get("VulnerabilityID") or "UNKNOWN")
                package = str(vuln.get("PkgName") or "")
                installed = str(vuln.get("InstalledVersion") or "")
                fixed = str(vuln.get("FixedVersion") or "")
                fixed_for_summary = fixed or "none"
                title = compact_text(vuln.get("Title"), 180, default="No title")
                summary_title = compact_text(vuln.get("Title"), 100, default="No title")
                description = compact_text(vuln.get("Description"), 260, default="")
                scanned_target = str(scan_result.get("Target") or "")

                payload = {
                    "event": "TRIVY_VULN",
                    "source": "trivy",
                    "report": report_name,
                    "target": target,
                    "scanned_target": scanned_target,
                    "severity": severity,
                    "cve": cve,
                    "package": package,
                    "installed": installed,
                    "fixed": fixed,
                    "title": title,
                    "description": description,
                    "summary": (
                        f"{severity} {cve} target={target} pkg={package} "
                        f"installed={installed} fix={fixed_for_summary} title={summary_title}"
                    ),
                }
                log_json_line(payload)

        if TRIVY_EMIT_DETAILED_FINDINGS:
            emit_detail_table(report_name, target)

    metrics_lines.extend(
        [
            'trivy_vulnerabilities_total{severity="UNKNOWN"} %s' % totals["UNKNOWN"],
            'trivy_vulnerabilities_total{severity="LOW"} %s' % totals["LOW"],
            'trivy_vulnerabilities_total{severity="MEDIUM"} %s' % totals["MEDIUM"],
            'trivy_vulnerabilities_total{severity="HIGH"} %s' % totals["HIGH"],
            'trivy_vulnerabilities_total{severity="CRITICAL"} %s' % totals["CRITICAL"],
            f"trivy_last_scan_timestamp_seconds {int(time.time())}",
        ]
    )

    write_metrics(metrics_lines)
    compress_reports()
    delete_old_reports()
    enforce_size_cap()
    return 0


def main() -> int:
    ensure_directories()

    with LOCK_FILE.open("w", encoding="utf-8") as lock_handle:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log_msg("Trivy scan skipped: another scan is already running")
            return 0

        log_msg("Trivy scan started")
        try:
            status = run_scan()
        except Exception as error:  # noqa: BLE001
            log_msg(f"Trivy scan failed: {error}")
            return 1

        if status != 0:
            return status

        log_msg("Trivy scan finished")
        return 0


if __name__ == "__main__":
    sys.exit(main())
